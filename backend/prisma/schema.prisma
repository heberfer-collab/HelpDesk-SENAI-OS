// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Chamado {
  id                        Int      @id @default(autoincrement())
  numeroChamado             String?
  nomeSolicitante           String
  emailSolicitante          String
  dataSolicitacao           DateTime @default(now())
  dataOcorrencia            DateTime
  localOcorrencia           String
  responsavelAmbiente       String
  patrimonio                String
  serieOriginal             String
  descricaoProblema         String
  status                    String   @default("Aberto") // Aberto, Em Atendimento, Aguardando Peça, Concluído
  horaInicioAtendimento     DateTime?
  horaConclusaoAtendimento  DateTime?
  dataSolucao               DateTime?
  solucaoAplicada           String?
  serieNova                 String?
  tipoServico               String?
  observacaoPatrimonio      String?
  tecnicoResponsavel        String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Ambiente {
  id          Int      @id @default(autoincrement())
  nome        String   @unique
  localizacao String?
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
}


model Status {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
}


model TipoServico {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
}


model ResponsavelSetor {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
}


model Tecnico {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
}


model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  password  String
  role      String   @default("USUARIO") // ADMIN, TECNICO, USUARIO
  createdAt DateTime @default(now())
  logs      Log[]
}

model Log {
  id        Int      @id @default(autoincrement())
  acao      String   // EX: "Criou Chamado", "Atualizou Status"
  detalhes  String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Computador {
  id            Int      @id @default(autoincrement())
  nome          String
  patrimonio    String?  @unique
  numeroSerie   String?
  macAddress    String   @unique
  ip            String?
  ambiente      String
  responsavelSetor String?
  lastSeen      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
